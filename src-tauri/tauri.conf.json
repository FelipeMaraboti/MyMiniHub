{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "myMiniHub",
  "version": "0.1.0",
  "identifier": "com.user.myminihub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "myMiniHub",
        "width": 420,
        "height": 580,
        "minWidth": 420,
        "minHeight": 580,
        "maxWidth": 420,
        "maxHeight": 580,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "center": true,
        "shadow": false
      }
    ],
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "tooltip": "myMiniHub"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preloadConnections": [
        "sqlite:minihub.db"
      ]
    }
  }
}
